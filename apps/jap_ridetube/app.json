{
  "id": "jap_ridetube",
  "title": "RideTube",
  "description": "Video in the car: an unofficial client for YouTube. Your Home, Subscriptions and Watch later (signed in on the car), search, channels and chapters; the sound through the car's media player, the picture only while parked (a podcast view while driving). Needs the jap-ridetube-d tool.",
  "id8": {
    "id": "jap_ridetube8",
    "loggingId": "RTB8",
    "description": "Video in the car, for iDrive 8: an unofficial client for YouTube. Your Home, Subscriptions and Watch later (signed in on the car), search with an on-screen keyboard, channels and chapters; the sound through the car's media player, the picture only while parked (a podcast view while driving). Touch only. Needs the jap-ridetube-d tool and the GPU renderer (mgu-render)."
  },
